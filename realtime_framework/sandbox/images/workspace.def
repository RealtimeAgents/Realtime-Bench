Bootstrap: docker
From: python:3.11-slim@sha256:e88e9763f943ec1834f992a4b51e0f24500486803e8bc534e5767af9ea65f6ce

# Where a gui+cli run_script runs (realtime_framework/workspace/runner.py): Python with Pillow,
# bash, and nothing of the task's: no browser, display, desktop tools, guest server or task code.
# The script reaches the task only through the action gateway's socket, mounted read-only at
# /rtact beside the rtact client; its files go in /workspace.

%files
    realtime_framework/sandbox/images/workspace-requirements.txt /opt/workspace-requirements.txt

%post
    set -eu
    umask 022
    pip install --no-cache-dir --require-hashes -r /opt/workspace-requirements.txt
    rm /opt/workspace-requirements.txt
    mkdir -p /workspace /rtact

%environment
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1
