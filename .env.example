# Copy this file to .env in the repository root, then edit .env.
# If you have a provider key, uncomment its variable and replace YOUR_API_KEY.
# Set only the credentials for the provider you use; no benchmark key is needed.

# LiteLLM openai/ models and OpenAI Realtime wrappers.
# OPENAI_API_KEY=YOUR_API_KEY

# OpenRouter (including Claude, GPT, and Gemini models served through OpenRouter).
# OPENROUTER_API_KEY=YOUR_API_KEY

# LiteLLM gemini/ models and Gemini Live wrappers.
# GEMINI_API_KEY=YOUR_API_KEY

# LiteLLM anthropic/ models (also used by the legacy native Anthropic preset).
# ANTHROPIC_API_KEY=YOUR_API_KEY

# LiteLLM moonshot/ models; for custom hosts, also pass --ak api_base=YOUR_HOST.
# MOONSHOT_API_KEY=YOUR_API_KEY

# Leaderboard submissions with `uv run rtbench upload` (docs/submit.md); request a token
# from realtime-agents@utlists.utexas.edu.
# RTBENCH_SUBMIT_TOKEN=YOUR_SUBMISSION_TOKEN
